# Copy this file to .env and fill in your values
# TELEGRAM_TOKEN is the only required value to enable the Telegram bot

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Get this from @BotFather on Telegram → /newbot
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
